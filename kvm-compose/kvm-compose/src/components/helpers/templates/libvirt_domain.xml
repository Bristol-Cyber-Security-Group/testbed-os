<?xml version="1.0" encoding="utf-8"?>
<domain type="kvm">
    <name>{{ guest_name }}</name>
    <cpu mode="host-model"></cpu>
    <vcpu>{{ vcpu }}</vcpu>
    <memory unit="MiB">{{ memory }}</memory>
    <os>
        <type arch="x86_64" machine="q35">hvm</type>
    </os>
    <features>
        <acpi/>
        <apic/>
    </features>
    <devices>
        <disk type="file" device="disk">
            <driver name="qemu" type="{{ disk_driver }}"></driver>
            <source file="{{ disk_path }}"></source>
            <target dev="hda" bus="virtio"></target>
        </disk>
        {% if cloud_init_iso %}
        <disk type="file" device="cdrom">
            <driver name="qemu" type="raw"></driver>
            <source file="{{ cloud_init_iso }}"></source>
            <readonly></readonly>
            <target dev="hdb" bus="scsi"></target>
            <address type='drive' controller='0' bus='0' target='0' unit='0'/>
        </disk>
        {% endif %}

        <!-- leave a pre-defined CDROM definition in the guest for hot-swapping CDROM in libvirt version <= 8 -->
        <disk type='file' device='cdrom'>
            <driver name='qemu' type='raw'/>
            <target dev='sdc' bus='scsi'/>
            <readonly/>
            <source file=''/>
            <address type='drive' controller='0' bus='0' target='0' unit='2'/>
        </disk>

        <graphics type="spice" autoport="yes">
            <listen type="address"/>
            <image compression="off"/>
        </graphics>
        {% if extended_graphics_support %}
        <video>
            <model type="qxl" ram="65536" vram="65536" vgamem="16384" heads="1" primary="yes"/>
            <address type="pci" domain="0x0000" bus="0x00" slot="0x01" function="0x0"/>
        </video>
        {% endif %}

        {% if interfaces %}
        {% for network_data in interfaces %}
        <interface type='ethernet'>
            <mac address='{{ network_data[1] }}'/>
            <target dev='{{ network_data[0] }}'/>
            <model type='virtio'/>
            <mtu size='1442'/>
            <address type='pci' domain='0x0000' bus='0x{{ network_data[2] }}' slot='0x00' function='0x0'/>
        </interface>
        {% endfor %}
        {% endif %}

        {% if backing_image_network %}
        <interface type="network">
            <source network="{{ backing_image_network }}"></source>
            <model  type="virtio"></model >
            <driver  name="vhost"></driver >
        </interface>
        {% endif %}

        <!-- serial port for guest control via pseudo terminal -->
        <serial type='pty'>
            <target port='0'/>
        </serial>
        <console type='pty'>
            <target type='serial' port='0'/>
        </console>

        <!-- SCSI controller for hot plugging CD ROMs to push files into guest -->
        <controller type="scsi" index="0" model="virtio-scsi">
            <alias name="scsi0"/>
            <address type="pci" domain="0x0000" bus="0x05" slot="0x00" function="0x0"/>
        </controller>

    </devices>
    <sysinfo type="smbios">
        <system>
            <entry name="serial">ds=nocloud;</entry>
        </system>
    </sysinfo>
</domain>
