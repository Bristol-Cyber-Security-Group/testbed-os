<!--        </nat>-->
    </forward>
<!--    <bridge name='test-br0' stp='on' delay='0'/>-->
<!--    <mtu size="2000"/>-->
<!--    <domain name='testbed.host' localOnly='yes'/>-->
    <ip address='192.168.subnetoctet.1' netmask='255.255.255.0'>
        <dhcp>
            <range start='192.168.subnetoctet.2' end='192.168.subnetoctet.254'/>
            <host mac="52:54:00:00:00:00" name="testbed-host-base" ip="192.168.subnetoctet.10"/>
            <host mac="52:54:00:00:00:01" name="testbed-host-one" ip="192.168.subnetoctet.11"/>
            <host mac="52:54:00:00:00:02" name="testbed-host-two" ip="192.168.subnetoctet.12"/>
            <host mac="52:54:00:00:00:03" name="testbed-host-three" ip="192.168.subnetoctet.13"/>
        </dhcp>
    </ip>

    <portgroup name='default' default='yes'>
        <forward>
            <port protocol='tcp' hostport='hostportbase' guestport='22' guestip='192.168.subnetoctet.10'/>
            <port protocol='tcp' hostport='hostportone' guestport='22' guestip='192.168.subnetoctet.11'/>
            <port protocol='tcp' hostport='hostporttwo' guestport='22' guestip='192.168.subnetoctet.12'/>
            <port protocol='tcp' hostport='hostportthree' guestport='22' guestip='192.168.subnetoctet.13'/>
        </forward>
    </portgroup>

</network>
